generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Trader {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  slug     String  @unique
  tabOrder Int
  imageUrl String?
  quests   Quest[]
}

model Quest {
  id            Int      @id @default(autoincrement())
  traderId      Int
  trader        Trader   @relation(fields: [traderId], references: [id])
  name          String
  wikiSlug      String   @unique
  wikiUrl       String
  objectives    String
  rewards       String
  requiredItems String   @default("[]")
  requirements  String   @default("{\"minLevel\":null,\"prerequisiteQuestSlugs\":[],\"loyaltyNotes\":[]}")
  completed     Boolean  @default(false)
  active        Boolean  @default(true)
  lastSeenAt    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
